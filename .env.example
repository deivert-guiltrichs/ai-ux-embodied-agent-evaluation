# Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Current model used by the prototype.
GEMINI_MODEL=gemini-2.5-flash-lite

# Local execution mode.
APP_ENV=local

# Planned separation for future iterations:
# LLM-A: conversational agent
# LLM-B: UX evaluator
AGENT_LLM_PROVIDER=gemini
AGENT_LLM_MODEL=gemini-2.5-flash-lite

EVALUATOR_LLM_PROVIDER=gemini
EVALUATOR_LLM_MODEL=gemini-2.5-flash-lite